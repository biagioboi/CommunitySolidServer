# ACR demonstrating two different access modes on the SAME resource,
# depending on which client/agent/issuer triple is presenting the VP.
@prefix acl: <http://www.w3.org/ns/auth/acl#>.
@prefix acp: <http://www.w3.org/ns/solid/acp#>.

<#dual-mode-resource.txt>
    a acp:AccessControlResource;
    acp:resource <./dual-mode-resource.txt>;
    acp:accessControl <#dualModeAccess>.

<#dualModeAccess>
    a acp:AccessControl;
    acp:apply [
        a acp:Policy;
        acp:allow acl:NRRead;
        acp:allOf [
            a acp:Matcher;
            acp:agent "did:web:bboi.solidcommunity.net:public";
            acp:issuer "did:web:secureissuer.solidcommunity.net:public";
            acp:client "did:web:secureapp.solidcommunity.net:public";
        ]
    ];
    acp:apply [
        a acp:Policy;
        acp:allow acl:Read;
        acp:allOf [
            a acp:Matcher;
            acp:agent "did:web:bboi.solidcommunity.net:public";
            acp:issuer "did:web:secureissuer.solidcommunity.net:public";
            acp:client "did:web:secureapp-2.solidcommunity.net:public";
        ]
    ].
